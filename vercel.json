{
  "framework": "nextjs",
  "regions": ["iad1"],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "X-Frame-Options",          "value": "DENY" },
        { "key": "X-XSS-Protection",         "value": "1; mode=block" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/schema-drift",      "schedule": "0 */6 * * *" },
    { "path": "/api/cron/uptime-check",      "schedule": "*/15 * * * *" },
    { "path": "/api/cron/reset-daily-calls", "schedule": "0 0 * * *" }
  ]
}
