# ── Site URL ─────────────────────────────────────────────────────────────────
# Used everywhere instead of hardcoded https://openmcp.dev
# NEXT_PUBLIC_ prefix makes it available in client components too.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only alias (if you don't want the URL in the client bundle):
# SITE_URL=https://openmcp.dev

# ── Sandbox Service ────────────────────────────────────────────────────────────
# Used to securely extract tool documentation from stdio CLI servers via docker
SANDBOX_URL=
SANDBOX_AUTH_TOKEN=

# ── Database ─────────────────────────────────────────────────────────────────
DB_PASSWORD=

# ── Brand Configuration ──────────────────────────────────────────────────────
# Override to rebrand without code changes
NEXT_PUBLIC_BRAND_NAME=Relay
NEXT_PUBLIC_BRAND_SLUG=Relay
NEXT_PUBLIC_BRAND_DOMAIN=http://localhost:3000
NEXT_PUBLIC_GITHUB_URL=https://github.com/akins-dev/openMCP
NEXT_PUBLIC_AGENT_MD_ROUTE=/agents.md

# ── Supabase (public — safe to commit) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ── Supabase (secret — never commit) ─────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Vercel Cron Auth ──────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
CRON_SECRET=your_random_cron_secret_here

# Smithery API key for ingest (free at smithery.ai)
SMITHERY_API_KEY=your_smithery_api_key_here

# Upstash Redis — for production rate limiting across Vercel instances
# Free tier sufficient. Create at console.upstash.com
# Without these, rate limiting falls back to in-memory (dev only)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Admin panel — your Supabase Auth user ID (UUID)
# Get from: Supabase → Authentication → Users → your row → User UID
NEXT_PUBLIC_ADMIN_UID=your-user-uuid-here

# ─────────────────────────────────────────────────────────────────────────────
# ⚠️  CRITICAL: DISABLE SUPABASE STATEMENT LOGGING BEFORE USING VAULT
# ─────────────────────────────────────────────────────────────────────────────
# Before storing any secrets through the vault, you MUST disable statement
# logging in Supabase. Otherwise secrets will be stored in plaintext in logs.
#
# How to disable:
#   Supabase Dashboard → Database → Database Settings → Log Settings
#   Set "Statement log level" to: none  (or verify it is set to: ddl)
#
# Supabase hosted projects default to DDL-only (safe). Verify before proceeding.
# This is non-negotiable. Do this BEFORE running migration 011.
# ─────────────────────────────────────────────────────────────────────────────

# ── OAuth client secrets (one per supported OAuth server) ─────────────────────
# Pattern: OAUTH_SECRET_{SERVER_NAME_UPPERCASE_WITH_UNDERSCORES}
# These are the client secrets from each service's OAuth app registration.
# Never expose these — server-side only, never NEXT_PUBLIC_
# Example:
# OAUTH_SECRET_GITHUB_TOOLS=your_github_oauth_app_secret
# OAUTH_SECRET_SLACK_MCP=your_slack_oauth_app_secret
# OAUTH_SECRET_LINEAR_TOOLS=your_linear_oauth_app_secret

# ── HMAC token signing secret ─────────────────────────────────────────────────
# Used to sign confirm tokens (tool policy confirmation flow).
# Generate: openssl rand -base64 32
# Falls back to CRON_SECRET if not set. Set this independently in production.
TOKEN_SECRET=generate_with_openssl_rand_base64_32

# ── Sentry error monitoring ───────────────────────────────────────────────────
# Create a project at sentry.io → Settings → Projects → New Project (Next.js)
# DSN is public-safe (goes to client bundle)
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/your-project-id

# Build-time only (for source map uploads in CI)
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=openmcp
SENTRY_AUTH_TOKEN=your-sentry-auth-token
